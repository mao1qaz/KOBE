        {TOOLS[star]:q} --runMode genomeGenerate \
            --runThreadN {threads} \
            --genomeDir {output.idx:q} \
            --genomeFastaFiles {input.fa:q} \
            --sjdbGTFfile {input.gtf:q} \
            --sjdbOverhang {params.sjdb_overhang} \
            --limitGenomeGenerateRAM {params.genome_ram}
