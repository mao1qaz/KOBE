# ============================================================
# 1. Load and validate sample manifest
# ============================================================
# sample_id: unique ID for each sequencing library.
# sample_name: biological grouping label used by downstream modules.
# sample_name may repeat; sample_id must be globally unique.
REQUIRED_COLUMNS = ["sample_id", "sample_name", "species", "type", "fq1", "fq2"]
SAMPLES = []
SAMPLE_LOOKUP = {}
SEEN_SAMPLE_IDS = set()

if not os.path.isfile(SAMPLES_TSV):
    raise FileNotFoundError(f"Sample manifest not found: {SAMPLES_TSV}")

with open(SAMPLES_TSV, newline="", encoding="utf-8-sig") as handle:
    reader = csv.DictReader(handle, delimiter="\t")

    if reader.fieldnames is None:
        raise ValueError("Sample manifest is empty.")

    missing = set(REQUIRED_COLUMNS) - set(reader.fieldnames)
    if missing:
        raise ValueError(f"Missing TSV columns: {sorted(missing)}")

    for line_no, raw in enumerate(reader, start=2):
        row = {key: (raw.get(key) or "").strip() for key in REQUIRED_COLUMNS}

        if any(not row[key] for key in REQUIRED_COLUMNS):
            raise ValueError(f"Empty required field at TSV line {line_no}")

        row["type"] = row["type"].upper()
        if row["type"] not in {"RNA", "DNA"}:
            raise ValueError(f"Invalid type at TSV line {line_no}: {row['type']}")

        for key in ["sample_id", "species"]:
            if any(char in row[key] for char in ["/", "\\", "\n", "\t"]):
                raise ValueError(f"Invalid {key} at TSV line {line_no}")

        if any(char in row["sample_name"] for char in ["\n", "\r", "\t"]):
            raise ValueError(f"Invalid sample_name at TSV line {line_no}")

        if row["sample_id"] in SEEN_SAMPLE_IDS:
            raise ValueError(
                f"sample_id must be globally unique; duplicate: {row['sample_id']}"
            )
        SEEN_SAMPLE_IDS.add(row["sample_id"])

        for key in ["fq1", "fq2"]:
            if not os.path.isabs(row[key]):
                row[key] = os.path.abspath(
                    os.path.join(os.path.dirname(SAMPLES_TSV), row[key])
                )
            if not os.path.isfile(row[key]):
                raise FileNotFoundError(
                    f"FASTQ file not found at TSV line {line_no}: {row[key]}"
                )

        key = (row["species"], row["type"], row["sample_id"])
        if key in SAMPLE_LOOKUP:
            raise ValueError(f"Duplicate sample entry: {key}")

        SAMPLE_LOOKUP[key] = row
        SAMPLES.append(row)

if not SAMPLES:
    raise ValueError("No samples found in the TSV file.")


def sample_row(w, type_):
    key = (w.sp, type_, w.sample_id)
    if key not in SAMPLE_LOOKUP:
        raise ValueError(f"Sample not found in TSV: {key}")
    return SAMPLE_LOOKUP[key]


# Build configurable fastp arguments.
FASTP_ARGS = [
    f"-n {FASTP_CFG.get('n_base_limit', 5)}",
    f"-q {FASTP_CFG.get('qualified_quality_phred', 15)}",
    f"-u {FASTP_CFG.get('unqualified_percent_limit', 50)}",
]

if FASTP_CFG.get("disable_length_filtering", False):
    FASTP_ARGS.append("-L")
elif FASTP_CFG.get("length_required") is not None:
    FASTP_ARGS.append(f"-l {FASTP_CFG['length_required']}")

if FASTP_CFG.get("average_qual", 0) > 0:
    FASTP_ARGS.append(f"-e {FASTP_CFG['average_qual']}")

if FASTP_CFG.get("disable_trim_poly_g", False):
    FASTP_ARGS.append("-G")

if FASTP_CFG.get("disable_adapter_trimming", False):
    FASTP_ARGS.append("-A")

if FASTP_CFG.get("detect_adapter_for_pe", False):
    FASTP_ARGS.append("--detect_adapter_for_pe")

FASTP_ARGS = " ".join(FASTP_ARGS)


# ============================================================
# 2. Final targets
# ============================================================
FINAL_TARGETS = []

for row in SAMPLES:
    sp = row["species"]
    sid = row["sample_id"]

    if row["type"] == "RNA":
        bam = f"{WORK_DIR}/01_MAP/{sp}/RNA/final/{sid}/split.bam"
    else:
        bam = f"{WORK_DIR}/01_MAP/{sp}/DNA/{sid}/{sid}.nodup.bam"

    FINAL_TARGETS.extend([bam, bam + ".bai"])


rule all:
    input:
        FINAL_TARGETS


# ============================================================
# 3. fastp QC for RNA and DNA
# ============================================================
rule fastp:
    input:
        r1=lambda w: sample_row(w, w.type)["fq1"],
        r2=lambda w: sample_row(w, w.type)["fq2"]
    output:
        r1=f"{WORK_DIR}/00_QC/{{sp}}/{{type}}/{{sample_id}}/qc.R1.fastq.gz",
        r2=f"{WORK_DIR}/00_QC/{{sp}}/{{type}}/{{sample_id}}/qc.R2.fastq.gz",
        html=f"{WORK_DIR}/00_QC/{{sp}}/{{type}}/{{sample_id}}/qc.html",
        json=f"{WORK_DIR}/00_QC/{{sp}}/{{type}}/{{sample_id}}/qc.json"
    threads: THREADS["fastp"]
    resources:
        mem_mb=MEM["fastp"]
    shell:
        """
        mkdir -p "$(dirname {output.r1:q})"
        {TOOLS[fastp]:q} {FASTP_ARGS} --thread {threads} \
            -i {input.r1:q} -I {input.r2:q} \
            -o {output.r1:q} -O {output.r2:q} \
            --html {output.html:q} --json {output.json:q}
        """


