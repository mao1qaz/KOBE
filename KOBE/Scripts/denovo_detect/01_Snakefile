def as_bool(value, default=False):
    """Parse YAML booleans and Snakemake CLI string booleans safely."""
    if isinstance(value, bool):
        return value
    if value is None:
        return default
    normalized = str(value).strip().lower()
    if normalized in {"1", "true", "yes", "on"}:
        return True
    if normalized in {"0", "false", "no", "off", ""}:
        return False
    raise ValueError(f"Invalid boolean value: {value!r}")


def as_optional_int(value):
    """Parse an optional integer; none/off/null means omit fastp's -l option."""
    if value is None:
        return None
    normalized = str(value).strip().lower()
    if normalized in {"none", "off", "null", ""}:
        return None
    try:
        parsed = int(normalized)
    except ValueError as exc:
        raise ValueError(
            f"Invalid fastp length-required value {value!r}; use a non-negative integer, none, or off."
        ) from exc
    if parsed < 0:
        raise ValueError(
            f"Invalid fastp length-required value {value!r}; the integer must be non-negative."
        )
    return parsed


