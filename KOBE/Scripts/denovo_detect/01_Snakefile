    threads: THREADS["samtools_sort"]
    shell:
        """
        {TOOLS[samtools]:q} view -bh -q 10 {input.bam:q} \
        | {TOOLS[samtools]:q} sort -@ {threads} -o {output.bam:q} -
        """


# 9. Extract BWA alignment coordinates for refinement
rule bwa_q10_aln:
    input:
        bam=f"{WORK_DIR}/01_MAP/{{sp}}/RNA/BWA/{{sample_id}}/{{sample_id}}.sort.q10.bam"
    output:
        aln=f"{WORK_DIR}/01_MAP/{{sp}}/RNA/BWA/{{sample_id}}/{{sample_id}}.bwa.q10.aln"
    shell:
        """
        {TOOLS[samtools]:q} view {input.bam:q} \
        | awk 'BEGIN{{OFS="\\t"}} $3 != "*" {{print $1,$2,$3,$4}}' \
        > {output.aln:q}
        """


# 10. RNA STAR mapping
rule star_map:
    input:
        r1=f"{WORK_DIR}/00_QC/{{sp}}/RNA/{{sample_id}}/qc.R1.fastq.gz",
        r2=f"{WORK_DIR}/00_QC/{{sp}}/RNA/{{sample_id}}/qc.R2.fastq.gz",
        index=f"{WORK_DIR}/00_REF/STAR/{{sp}}"
    output:
        bam=f"{WORK_DIR}/01_MAP/{{sp}}/RNA/STAR/{{sample_id}}/{{sample_id}}.sort.bam"
    params:
        prefix=f"{WORK_DIR}/01_MAP/{{sp}}/RNA/STAR/{{sample_id}}/{{sample_id}}_",
        aligned=f"{WORK_DIR}/01_MAP/{{sp}}/RNA/STAR/{{sample_id}}/{{sample_id}}_Aligned.sortedByCoord.out.bam",
        tmp=f"{WORK_DIR}/tmp/STAR/{{sp}}/{{sample_id}}",
        sort_ram=STAR_CFG["limit_bam_sort_ram"]
    threads: THREADS["star"]
    resources:
        mem_mb=MEM["star_map"]
    shell:
        """
        mkdir -p "$(dirname {output.bam:q})"
        mkdir -p "$(dirname {params.tmp:q})"
        rm -rf {params.tmp:q}
        {TOOLS[star]:q} --runThreadN {threads} \
            --readFilesCommand zcat \
            --outSAMtype BAM SortedByCoordinate \
            --outReadsUnmapped Fastx \
            --outFilterMultimapNmax 1 \
            --outFilterMismatchNmax 10 \
            --twopassMode Basic \
            --limitBAMsortRAM {params.sort_ram} \
            --genomeDir {input.index:q} \
            --readFilesIn {input.r1:q} {input.r2:q} \
            --outFileNamePrefix {params.prefix:q} \
            --outSAMattrRGline ID:{wildcards.sample_id} SM:{wildcards.sample_id} \
            --outTmpDir {params.tmp:q}
        mv {params.aligned:q} {output.bam:q}
        """


