    input:
        bam=f"{WORK_DIR}/01_MAP/{{sp}}/RNA/STAR/{{sample_id}}/{{sample_id}}.sort.q10.refine.bam"
    output:
        bam=f"{WORK_DIR}/01_MAP/{{sp}}/RNA/STAR/{{sample_id}}/{{sample_id}}.sort.q10.refine.nodup.bam",
        metrics=f"{WORK_DIR}/01_MAP/{{sp}}/RNA/STAR/{{sample_id}}/{{sample_id}}.metrics"
    params:
        tmp=f"{WORK_DIR}/tmp/Picard/{{sp}}/{{sample_id}}",
        heap_g=int(MEM["picard"] / 1024)
    resources:
        mem_mb=MEM["picard"]
    shell:
        """
        mkdir -p "$(dirname {output.bam:q})"
        mkdir -p {params.tmp:q}
