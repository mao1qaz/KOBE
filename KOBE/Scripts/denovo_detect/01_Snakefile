        bai=f"{WORK_DIR}/01_MAP/{{sp}}/DNA/{{sample_id}}/{{sample_id}}.sort.bam.bai"
    output:
        bam=f"{WORK_DIR}/01_MAP/{{sp}}/DNA/{{sample_id}}/{{sample_id}}.nodup.bam",
        bai=f"{WORK_DIR}/01_MAP/{{sp}}/DNA/{{sample_id}}/{{sample_id}}.nodup.bam.bai"
    params:
        tmp=f"{WORK_DIR}/tmp/Sambamba/markdup/{{sp}}/{{sample_id}}",
        overflow=SAMBAMBA_CFG["overflow_list_size"]
    threads: THREADS["sambamba"]
    resources:
        mem_mb=MEM["sambamba_sort"]
    shell:
        """
        mkdir -p {params.tmp:q}
        {TOOLS[sambamba]:q} markdup \
            --overflow-list-size {params.overflow} \
            -t {threads} -r \
            --tmpdir {params.tmp:q} \
            {input.bam:q} {output.bam:q}
        {TOOLS[sambamba]:q} index -t {threads} \
            {output.bam:q} {output.bai:q}
        """
