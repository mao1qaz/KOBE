    output:
        fa=f"{WORK_DIR}/00_REF/GENOME/{{sp}}.fa",
        fai=f"{WORK_DIR}/00_REF/GENOME/{{sp}}.fa.fai",
        dictionary=f"{WORK_DIR}/00_REF/GENOME/{{sp}}.dict"
    resources:
        mem_mb=MEM["reference_prepare"]
    shell:
        """
        mkdir -p "$(dirname {output.fa:q})"
        ln -sfn {input.fa:q} {output.fa:q}
        {TOOLS[samtools]:q} faidx {output.fa:q}
        rm -f {output.dictionary:q}
        {TOOLS[java]:q} -Xmx4g -jar {TOOLS[picard]:q} \
            CreateSequenceDictionary R={output.fa:q} O={output.dictionary:q}
        """


