    raise FileNotFoundError(f"Sample table not found: {SAMPLES_TSV}")

# Read sample identity. sample_id must be globally unique.
SAMPLES = []
SEEN_IDS = set()
with open(SAMPLES_TSV, newline="", encoding="utf-8-sig") as handle:
    reader = csv.DictReader(handle, delimiter="\t")
    required_columns = {"sample_id", "sample_name", "species", "type"}
    if not reader.fieldnames or not required_columns.issubset(reader.fieldnames):
        raise ValueError(
            "samples.tsv requires sample_id, sample_name, species, and type columns"
        )

    for line_num, row in enumerate(reader, 2):
        sid = (row.get("sample_id") or "").strip()
        sample_name = (row.get("sample_name") or "").strip()
        species = (row.get("species") or "").strip()
        typ = (row.get("type") or "").strip().upper()

        if not sid or not sample_name or not species or typ not in {"DNA", "RNA"}:
            raise ValueError(f"Invalid sample metadata at samples.tsv line {line_num}")
        if any(char in sid + species for char in "/\\,\t\n "):
            raise ValueError(f"Invalid sample_id or species at samples.tsv line {line_num}")
        if any(char in sample_name for char in "\t\n"):
            raise ValueError(f"Invalid sample_name at samples.tsv line {line_num}")
        if sid in SEEN_IDS:
            raise ValueError(f"sample_id must be globally unique; duplicate: {sid}")

        SEEN_IDS.add(sid)
        SAMPLES.append({
            "sample_id": sid,
            "sample_name": sample_name,
            "species": species,
            "type": typ,
        })

SPECIES_CONFIG = config.get("species")
if isinstance(SPECIES_CONFIG, str):
    SPECIES_CONFIG = [x.strip() for x in SPECIES_CONFIG.split(",") if x.strip()]
SPECIES = sorted(set(SPECIES_CONFIG or [row["species"] for row in SAMPLES]))
if not SPECIES:
    raise ValueError("No species selected for analysis")

for sp in SPECIES:
    subset = [row for row in SAMPLES if row["species"] == sp]
    if not subset:
        raise ValueError(f"Species {sp} is not present in Module 01 samples.tsv")
    if not {"DNA", "RNA"}.issubset({row["type"] for row in subset}):
        raise ValueError(f"At least one DNA and one RNA sample are required for {sp}")

    rna_names = {row["sample_name"] for row in subset if row["type"] == "RNA"}
    dna_names = {row["sample_name"] for row in subset if row["type"] == "DNA"}
    unmatched = sorted(rna_names - dna_names)
    if unmatched:
        raise ValueError(f"RNA sample_name values without matched DNA libraries in {sp}: {unmatched}")


def sample_rows(sp):
    return sorted(
        (row for row in SAMPLES if row["species"] == sp),
        key=lambda row: (0 if row["type"] == "DNA" else 1, row["sample_id"]),
    )


def mapping_bam(row):
    sp, sid = row["species"], row["sample_id"]
    if row["type"] == "DNA":
        return os.path.join(MAP_DIR, sp, "DNA", sid, f"{sid}.nodup.bam")
    return os.path.join(MAP_DIR, sp, "RNA", "final", sid, "split.bam")


def species_bams(wildcards):
    return [mapping_bam(row) for row in sample_rows(wildcards.sp)]


def species_bais(wildcards):
    return [mapping_bam(row) + ".bai" for row in sample_rows(wildcards.sp)]


def sample_csv(wildcards, sample_type):
    return ",".join(
        row["sample_id"]
        for row in sample_rows(wildcards.sp)
        if row["type"] == sample_type
    )


# Annotated VCFs and unfiltered candidate tables are reusable across thresholds.
# --reannotate explicitly forces only SnpEff annotation and candidate extraction.
ANNOTATED_VCFS = {
    sp: os.path.join(OUT_DIR, sp, "DNA_RNA.var.snpeff.vcf")
    for sp in SPECIES
}
MISSING_ANNOTATED_VCFS = [
    (sp, path)
    for sp, path in ANNOTATED_VCFS.items()
    if not os.path.isfile(path) or os.path.getsize(path) == 0
]
NEED_ANNOTATION = FORCE_REANNOTATE or bool(MISSING_ANNOTATED_VCFS)

if NEED_ANNOTATION and not FILTER_ONLY:
    if not SNPEFF_ROOT:
        raise ValueError(
            "SnpEff annotation is required, but no database directory was supplied. "
            "Pass --snpeff-dir DIR to denovo_detect_anno. "
            "The workflow does not infer project data paths from the KOBE installation "
            "or from the work directory."
        )
    species_needing_annotation = (
        SPECIES if FORCE_REANNOTATE else [sp for sp, _path in MISSING_ANNOTATED_VCFS]
    )
    missing_snpeff = []
    for sp in species_needing_annotation:
        db_file = os.path.join(SNPEFF_DATA, sp, "snpEffectPredictor.bin")
        species_config = os.path.join(SNPEFF_CONFIG_DIR, f"{sp}.config")
        if not os.path.isfile(db_file):
            missing_snpeff.append((sp, "database", db_file))
        if not os.path.isfile(species_config):
            missing_snpeff.append((sp, "config", species_config))

    if missing_snpeff:
        details = "\n".join(f"  {sp} [{kind}]: {path}" for sp, kind, path in missing_snpeff)
        raise ValueError(
            "SnpEff database/configuration is missing for one or more selected species.\n"
            f"SnpEff root searched: {SNPEFF_ROOT}\nMissing resources:\n{details}"
        )
    if not os.path.isfile(JAR):
        raise FileNotFoundError(f"SnpEff JAR not found: {JAR}")

