# Module 03 exporter expects fixed input names (genic.selected.tsv and
# intergenic.selected.tsv). Stage symlinks with those names, run the unchanged
# exporter, then rename its three outputs with the active threshold tag.
rule export_final_edit_sites:
    input:
        genic=os.path.join(OUT_DIR, "{sp}", f"genic.{THRESHOLD_TAG}.selected.tsv"),
        intergenic=os.path.join(OUT_DIR, "{sp}", f"intergenic.{THRESHOLD_TAG}.selected.tsv"),
        samples=SAMPLES_TSV,
        script=EXPORT_SCRIPT
    output:
        genic=os.path.join(FINAL_OUT_DIR, "{sp}", f"genic.final_sites.{THRESHOLD_TAG}.tsv"),
        intergenic=os.path.join(FINAL_OUT_DIR, "{sp}", f"intergenic.final_sites.{THRESHOLD_TAG}.tsv"),
        all=os.path.join(FINAL_OUT_DIR, "{sp}", f"all.final_sites.{THRESHOLD_TAG}.tsv")
    params:
        python=PYTHON,
        tag=THRESHOLD_TAG
    log:
        os.path.join(OUT_DIR, "{sp}", "logs", "03_export_final_sites." + THRESHOLD_TAG + ".log")
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {log:q})" "$(dirname {output.genic:q})"
        stage_root="$(mktemp -d "$(dirname {output.genic:q})/.stage_{wildcards.sp}_{params.tag}.XXXXXX")"
        trap 'rm -rf "$stage_root"' EXIT

        mkdir -p "$stage_root/input/{wildcards.sp}" "$stage_root/output"
        ln -s "$(realpath {input.genic:q})" "$stage_root/input/{wildcards.sp}/genic.selected.tsv"
        ln -s "$(realpath {input.intergenic:q})" "$stage_root/input/{wildcards.sp}/intergenic.selected.tsv"

        {params.python:q} {input.script:q} \
            --input-root "$stage_root/input" \
            --samples {input.samples:q} \
            --output-root "$stage_root/output" \
            --species {wildcards.sp:q} > {log:q} 2>&1

        test -s "$stage_root/output/{wildcards.sp}/genic.final_sites.tsv"
        test -s "$stage_root/output/{wildcards.sp}/intergenic.final_sites.tsv"
        test -s "$stage_root/output/{wildcards.sp}/all.final_sites.tsv"

        mv -f "$stage_root/output/{wildcards.sp}/genic.final_sites.tsv" {output.genic:q}
        mv -f "$stage_root/output/{wildcards.sp}/intergenic.final_sites.tsv" {output.intergenic:q}
        mv -f "$stage_root/output/{wildcards.sp}/all.final_sites.tsv" {output.all:q}

        trap - EXIT
        rm -rf "$stage_root"
        """


# The denominator is the sum of all 12 mutation classes in supported.tsv,
# exactly matching the mutation_types.pdf. Numerators are checked against
# selected.tsv: genic A>G; intergenic A>G + T>C.
rule summarize_variant_type_proportions:
    input:
        genic_supported=os.path.join(OUT_DIR, "{sp}", f"genic.{THRESHOLD_TAG}.supported.tsv"),
        intergenic_supported=os.path.join(OUT_DIR, "{sp}", f"intergenic.{THRESHOLD_TAG}.supported.tsv"),
        genic_selected=os.path.join(OUT_DIR, "{sp}", f"genic.{THRESHOLD_TAG}.selected.tsv"),
        intergenic_selected=os.path.join(OUT_DIR, "{sp}", f"intergenic.{THRESHOLD_TAG}.selected.tsv")
    output:
        summary=os.path.join(FINAL_OUT_DIR, "{sp}", f"variant_type_proportion.{THRESHOLD_TAG}.tsv")
    run:
        os.makedirs(os.path.dirname(output.summary), exist_ok=True)

        def count_mutations(path):
            counts = Counter({mutation: 0 for mutation in MUTATION_TYPES})
            unclassified = 0

            with open(path, "r", encoding="utf-8-sig", newline="") as handle:
                reader = csv.DictReader(handle, delimiter="\t")
                if not reader.fieldnames or "mut" not in reader.fieldnames:
                    raise ValueError(f"Missing 'mut' column in mutation table: {path}")
                for row in reader:
                    mutation = (row.get("mut") or "").strip().upper()
                    if mutation in counts:
                        counts[mutation] += 1
                    else:
                        unclassified += 1

            return counts, unclassified

        def count_selected(path, allowed_mutations):
            n = 0
            with open(path, "r", encoding="utf-8-sig", newline="") as handle:
                reader = csv.DictReader(handle, delimiter="\t")
                if not reader.fieldnames or "mut" not in reader.fieldnames:
                    raise ValueError(f"Missing 'mut' column in selected-site table: {path}")
                for row in reader:
                    mutation = (row.get("mut") or "").strip().upper()
                    if mutation not in allowed_mutations:
                        raise ValueError(
                            f"Unexpected mutation {mutation!r} in {path}; "
                            f"expected one of {sorted(allowed_mutations)}"
                        )
                    n += 1
            return n

        genic_counts, genic_unclassified = count_mutations(input.genic_supported)
        intergenic_counts, intergenic_unclassified = count_mutations(input.intergenic_supported)

        genic_target_n = count_selected(input.genic_selected, {"A>G"})
        intergenic_target_n = count_selected(input.intergenic_selected, {"A>G", "T>C"})

        rows = []
        for region, counts, unclassified, targets, target_n in (
            ("genic", genic_counts, genic_unclassified, ("A>G",), genic_target_n),
            ("intergenic", intergenic_counts, intergenic_unclassified, ("A>G", "T>C"), intergenic_target_n),
        ):
            total = sum(counts[mutation] for mutation in MUTATION_TYPES)
            supported_target_n = sum(counts[mutation] for mutation in targets)

            if target_n != supported_target_n:
                raise ValueError(
                    f"Selected/support count mismatch for {wildcards.sp} {region}: "
                    f"selected={target_n}, supported target classes={supported_target_n}"
                )

            percentage = target_n / total * 100.0 if total else None
            row = {
                "species": wildcards.sp,
                "region": region,
                "target_mutation_types": ";".join(targets),
                "target_site_count": target_n,
                "all_12_mutation_type_sites": total,
                "proportion_percent": f"{percentage:.4f}" if percentage is not None else "NA",
                "unclassified_rows_excluded_from_plot_denominator": unclassified,
            }
            for mutation in MUTATION_TYPES:
                row[mutation] = counts[mutation]
            rows.append(row)

        columns = [
            "species", "region", "target_mutation_types", "target_site_count",
            "all_12_mutation_type_sites", "proportion_percent",
            "unclassified_rows_excluded_from_plot_denominator",
        ] + MUTATION_TYPES

        temp_path = output.summary + f".tmp.{os.getpid()}"
        try:
            with open(temp_path, "w", encoding="utf-8", newline="") as handle:
                writer = csv.DictWriter(
                    handle, fieldnames=columns, delimiter="\t", lineterminator="\n"
                )
                writer.writeheader()
                writer.writerows(rows)
            os.replace(temp_path, output.summary)
        finally:
            if os.path.exists(temp_path):
                os.remove(temp_path)
