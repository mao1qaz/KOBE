# Module 01 BAM header verification.
rule validate_bam_samples:
    input:
        bams=species_bams,
        bais=species_bais
    output:
        report=os.path.join(OUT_DIR, "{sp}", "sample_header_check.tsv")
    run:
        rows = sample_rows(wildcards.sp)
        os.makedirs(os.path.dirname(output.report), exist_ok=True)
        results = []

        for row in rows:
            bam = mapping_bam(row)
            completed = subprocess.run(
                [SAMTOOLS, "view", "-H", bam],
                capture_output=True,
                text=True,
                check=True,
            )
            sms = set()
            for line in completed.stdout.splitlines():
                if not line.startswith("@RG\t"):
                    continue
                for field in line.split("\t")[1:]:
                    if field.startswith("SM:"):
                        sms.add(field[3:])

            if sms != {row["sample_id"]}:
                raise ValueError(
                    f"BAM sample mismatch: {bam}; expected SM={row['sample_id']}; "
                    f"found={sorted(sms)}. Fix BAM Read Groups before running Module 02."
                )
            results.append((row, bam))

        with open(output.report, "w", encoding="utf-8") as handle:
            handle.write("sample_id\tsample_name\tspecies\ttype\tbam\tSM\n")
            for row, bam in results:
                handle.write(
                    f"{row['sample_id']}\t{row['sample_name']}\t{row['species']}\t"
                    f"{row['type']}\t{bam}\t{row['sample_id']}\n"
                )


# If the SnpEff VCF already exists, Snakemake reuses it and does not need
# to schedule these upstream rules. If absent, the original upstream route remains.
rule mpileup_vcf:
    input:
        fa=os.path.join(MAP_REF_DIR, "{sp}.fa"),
        fai=os.path.join(MAP_REF_DIR, "{sp}.fa.fai"),
        bams=species_bams,
        bais=species_bais,
        check=os.path.join(OUT_DIR, "{sp}", "sample_header_check.tsv")
    output:
        vcf=os.path.join(OUT_DIR, "{sp}", "DNA_RNA.vcf30.vcf")
    params:
        samtools=SAMTOOLS,
        min_bq=MP_MIN_BQ,
        opts=MP_ARGS
    threads: 1
    resources:
        mem_mb=MP_MEMORY_MB
    log:
        os.path.join(OUT_DIR, "{sp}", "logs", "mpileup.log")
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {log:q})"
        {params.samtools:q} mpileup -f {input.fa:q} -Q {params.min_bq} {params.opts} {input.bams:q} \
            > {output.vcf:q} 2> {log:q}
        test -s {output.vcf:q}
        """


rule normalize_candidate_vcf:
    input:
        vcf=os.path.join(OUT_DIR, "{sp}", "DNA_RNA.vcf30.vcf"),
        script=PARSER
    output:
        vcf=os.path.join(OUT_DIR, "{sp}", "DNA_RNA.var.vcf")
    params:
        python=PYTHON,
        dna=lambda wildcards: sample_csv(wildcards, "DNA"),
        rna=lambda wildcards: sample_csv(wildcards, "RNA"),
        accept_plain=ACCEPT_SIMPLE_SNV
    log:
        os.path.join(OUT_DIR, "{sp}", "logs", "normalize.log")
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {log:q})"
        {params.python:q} {input.script:q} normalize \
            --input {input.vcf:q} --output {output.vcf:q} \
            --dna {params.dna:q} --rna {params.rna:q} \
            --accept-plain {params.accept_plain} > {log:q} 2>&1
        test -s {output.vcf:q}
        """


rule snpeff_annotate:
    input:
        vcf=os.path.join(OUT_DIR, "{sp}", "DNA_RNA.var.vcf"),
        db=os.path.join(SNPEFF_DATA, "{sp}", "snpEffectPredictor.bin"),
        config=os.path.join(SNPEFF_CONFIG_DIR, "{sp}.config"),
        jar=JAR
    output:
        # Keep only the annotated VCF as a declared output. The HTML report is
        # still generated, but a missing HTML file will not force re-annotation
        # when an existing annotated VCF is being reused.
        vcf=os.path.join(OUT_DIR, "{sp}", "DNA_RNA.var.snpeff.vcf")
    params:
        java=JAVA,
        heap=ANN_HEAP,
        data_dir=SNPEFF_DATA,
        opts=ANN_ARGS,
        stats=lambda wildcards: os.path.join(OUT_DIR, wildcards.sp, "DNA_RNA.snpeff_summary.html")
    resources:
        mem_mb=ANN_MEMORY_MB
    log:
        os.path.join(OUT_DIR, "{sp}", "logs", "snpeff.log")
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {log:q})"
        {params.java:q} -Xmx{params.heap} -jar {input.jar:q} ann {params.opts} \
            -c {input.config:q} -dataDir {params.data_dir:q} \
            -stats {params.stats:q} {wildcards.sp} {input.vcf:q} \
            > {output.vcf:q} 2> {log:q}
        test -s {output.vcf:q}
        """


# Extract every annotated SNV and per-library REF/ALT count.
# No DNA/RNA coverage threshold is applied in this rule.
rule extract_regions_prefilter:
    input:
        vcf=os.path.join(OUT_DIR, "{sp}", "DNA_RNA.var.snpeff.vcf"),
        script=PARSER
    output:
        genic=os.path.join(OUT_DIR, "{sp}", "genic.candidates.tsv"),
        intergenic=os.path.join(OUT_DIR, "{sp}", "intergenic.candidates.tsv")
    params:
        python=PYTHON,
        dna=lambda wildcards: sample_csv(wildcards, "DNA"),
        rna=lambda wildcards: sample_csv(wildcards, "RNA"),
        genic_mode=GENIC_MODE
    log:
        os.path.join(OUT_DIR, "{sp}", "logs", "extract_candidates.log")
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {log:q})"
        tmp_genic="{output.genic}.tmp.$$"
        tmp_intergenic="{output.intergenic}.tmp.$$"
        trap 'rm -f "$tmp_genic" "$tmp_intergenic"' EXIT

        {params.python:q} {input.script:q} extract \
            --input {input.vcf:q} \
            --genic "$tmp_genic" \
            --intergenic "$tmp_intergenic" \
            --dna {params.dna:q} \
            --rna {params.rna:q} \
            --genic-mode {params.genic_mode:q} > {log:q} 2>&1

        test -s "$tmp_genic"
        test -s "$tmp_intergenic"
        mv -f "$tmp_genic" {output.genic:q}
        mv -f "$tmp_intergenic" {output.intergenic:q}
        trap - EXIT
        """


rule filter_and_plot_region:
    input:
        tsv=os.path.join(OUT_DIR, "{sp}", "{region}.candidates.tsv"),
        script=R_FILTER
    output:
        stats=os.path.join(OUT_DIR, "{sp}", "{region}." + THRESHOLD_TAG + ".with_stat.tsv"),
        filtered=temp(os.path.join(OUT_DIR, "{sp}", "{region}." + THRESHOLD_TAG + ".fdr05.tsv")),
        supported=temp(os.path.join(OUT_DIR, "{sp}", "{region}." + THRESHOLD_TAG + ".supported.tsv")),
        selected=temp(os.path.join(OUT_DIR, "{sp}", "{region}." + THRESHOLD_TAG + ".selected.tsv")),
        pdf=os.path.join(FINAL_OUT_DIR, "{sp}", "{region}." + THRESHOLD_TAG + ".mutation_types.pdf"),
        summary=temp(os.path.join(OUT_DIR, "{sp}", "{region}." + THRESHOLD_TAG + ".filter_summary.tsv")),
        sample_summary=temp(os.path.join(OUT_DIR, "{sp}", "{region}." + THRESHOLD_TAG + ".sample_test_summary.tsv"))
    params:
        rscript=RSCRIPT,
        prefix=lambda wildcards: os.path.join(
            OUT_DIR, wildcards.sp, f"{wildcards.region}.{THRESHOLD_TAG}"
        ),
        sample_table=SAMPLES_TSV,
        species=lambda wildcards: wildcards.sp,
        dna_min=DNA_MIN,
        dna_fdr=DNA_FDR_CUTOFF,
        rna_min=RNA_MIN,
        rna_fdr=RNA_FDR_CUTOFF,
        error_rate=ERROR_RATE,
        min_support=MIN_SUPPORT
    log:
        os.path.join(OUT_DIR, "{sp}", "logs", "{region}." + THRESHOLD_TAG + ".filter.log")
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {log:q})" "$(dirname {output.pdf:q})"
        tmp_prefix="{params.prefix}.tmp.$$"
        trap 'rm -f "$tmp_prefix".*' EXIT

        {params.rscript:q} {input.script:q} \
            {input.tsv:q} "$tmp_prefix" {wildcards.region:q} \
            {params.sample_table:q} {params.species:q} \
            {params.dna_min} {params.dna_fdr} {params.rna_min} {params.rna_fdr} \
            {params.error_rate} {params.min_support} > {log:q} 2>&1

        for suffix in with_stat.tsv fdr05.tsv supported.tsv selected.tsv \
                      mutation_types.pdf filter_summary.tsv sample_test_summary.tsv; do
            test -s "$tmp_prefix.$suffix"
        done

        mv -f "$tmp_prefix.with_stat.tsv" {output.stats:q}
        mv -f "$tmp_prefix.fdr05.tsv" {output.filtered:q}
        mv -f "$tmp_prefix.supported.tsv" {output.supported:q}
        mv -f "$tmp_prefix.selected.tsv" {output.selected:q}
        mv -f "$tmp_prefix.mutation_types.pdf" {output.pdf:q}
        mv -f "$tmp_prefix.filter_summary.tsv" {output.summary:q}
        mv -f "$tmp_prefix.sample_test_summary.tsv" {output.sample_summary:q}
        trap - EXIT
        """


