def sample_path(wildcards, key):
    return SAMPLES[(wildcards.sp, wildcards.sample_id)][key]


def fastp_input_paths(wildcards):
    sample = SAMPLES[(wildcards.sp, wildcards.sample_id)]
    fq1, fq2 = sample["fq1"], sample["fq2"]
    if fq1 and fq2 and Path(fq1).is_file() and Path(fq2).is_file():
        return [fq1, fq2]
    clean_r1 = Path(WORK_DIR) / wildcards.sp / "00_QC" / wildcards.sample_id / "qc.R1.fastq.gz"
    clean_r2 = Path(WORK_DIR) / wildcards.sp / "00_QC" / wildcards.sample_id / "qc.R2.fastq.gz"
    if (REUSE_BAM or RESUME_MODE) and clean_r1.is_file() and clean_r1.stat().st_size > 0 and clean_r2.is_file() and clean_r2.stat().st_size > 0:
        return []
    raise FileNotFoundError(
        f"No complete raw FASTQ pair or retained clean FASTQ pair for "
        f"{wildcards.sp}/{wildcards.sample_id}."
    )


def use_retained_clean_fastq(wildcards):
    sample = SAMPLES[(wildcards.sp, wildcards.sample_id)]
    raw_pair_ok = bool(
        sample["fq1"] and sample["fq2"]
        and Path(sample["fq1"]).is_file() and Path(sample["fq2"]).is_file()
    )
    clean_r1 = Path(WORK_DIR) / wildcards.sp / "00_QC" / wildcards.sample_id / "qc.R1.fastq.gz"
    clean_r2 = Path(WORK_DIR) / wildcards.sp / "00_QC" / wildcards.sample_id / "qc.R2.fastq.gz"
    use_clean = (not raw_pair_ok) and clean_r1.is_file() and clean_r1.stat().st_size > 0 and clean_r2.is_file() and clean_r2.stat().st_size > 0
    return "true" if use_clean else "false"


def species_path(wildcards, key):
    return SPECIES_INFO[wildcards.sp][key]


def sample_uses_reused_bam(wildcards):
    return REUSE_BAM and (wildcards.sp, wildcards.sample_id) in REUSE_BAM_KEYS


def reditool_bam_path(wildcards):
    if sample_uses_reused_bam(wildcards):
        return f"{WORK_DIR}/.reuse_bam_inputs/{wildcards.sp}/{wildcards.sample_id}.sort.q10.nodup.bam"
    return f"{WORK_DIR}/{wildcards.sp}/03_PICARD/{wildcards.sample_id}/{wildcards.sample_id}.sort.q10.nodup.bam"


def reditool_bai_path(wildcards):
    return reditool_bam_path(wildcards) + ".bai"


def reuse_validation_path(wildcards):
    if sample_uses_reused_bam(wildcards):
        return f"{WORK_DIR}/.reuse_bam_validated/{wildcards.sp}/{wildcards.sample_id}.ok"
    return []


