def read_samples(path):
    samples = {}
    species_info = {}

    with open(path, encoding="utf-8-sig", newline="") as handle:
        reader = csv.DictReader(handle, delimiter="\t")
        if not reader.fieldnames:
            raise ValueError("Sample table has no header.")
        reader.fieldnames = [x.strip().lstrip("\ufeff") for x in reader.fieldnames]

        required = {"sample_id", "species", "fq1", "fq2"}
        missing = required - set(reader.fieldnames)
        genome_col = next((x for x in ("genome_fasta", "genome", "reference_fasta", "ref") if x in reader.fieldnames), None)
        if missing or genome_col is None:
            raise ValueError("Sample table must contain sample_id, species, fq1, fq2, and genome_fasta (or genome/ref).")

        for line_number, raw in enumerate(reader, start=2):
            if not raw or not any((value or "").strip() for value in raw.values()):
                continue

            sample_id = safe_name(raw.get("sample_id"), "sample_id", line_number)
            species = safe_name(raw.get("species"), "species", line_number)

            if "type" in raw and (raw.get("type") or "").strip():
                sample_type = raw["type"].strip().upper()
                if sample_type != "RNA":
                    raise ValueError(f"Only RNA samples are accepted: {species}/{sample_id}, type={sample_type}")

            fq_paths = {}
            for column in ("fq1", "fq2"):
                value = strip_quotes(raw.get(column))
                if not value:
                    if not (REUSE_BAM or RESUME_MODE):
                        raise ValueError(f"Empty {column}: {species}/{sample_id}; FASTQ can be omitted only when reusable BAMs or retained clean FASTQs are available in resume/reuse mode.")
                    fq_paths[column] = ""
                    continue
                resolved = resolve_path(value, f"{column} for {species}/{sample_id}", must_exist=False, base_dir=Path(path).parent)
                if not os.path.isfile(resolved) and not (REUSE_BAM or RESUME_MODE):
                    raise FileNotFoundError(f"Missing {column} for {species}/{sample_id}: {resolved}")
                fq_paths[column] = resolved

            genome = resolve_path(raw.get(genome_col), f"genome_fasta for {species}/{sample_id}", base_dir=Path(path).parent)
            key = (species, sample_id)
            if key in samples:
                raise ValueError(f"Duplicate sample: {species}/{sample_id}")
            if species in species_info and species_info[species]["genome"] != genome:
                raise ValueError(f"Different genome FASTA files detected within species {species}.")

            samples[key] = {**fq_paths, "genome": genome}
            species_info.setdefault(species, {"genome": genome})

    if not samples:
        raise ValueError("No RNA samples found.")
    return samples, species_info


