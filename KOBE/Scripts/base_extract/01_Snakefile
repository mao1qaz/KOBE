# ============================================================
# REDItoolKnown; one independent Snakemake job per sample
# ============================================================

rule reditool_known:
    input:
        bam=lambda wc: reditool_bam_path(wc),
        bai=lambda wc: reditool_bai_path(wc),
        validation=reuse_validation_path,
        fasta=f"{WORK_DIR}/{{sp}}/00_REF/GENOME/{{sp}}.fa",
        fai=f"{WORK_DIR}/{{sp}}/00_REF/GENOME/{{sp}}.fa.fai",
        sites=f"{WORK_DIR}/{{sp}}/00_INPUT/known_sites.redi.tab"
    output:
        result=directory(f"{WORK_DIR}/{{sp}}/04_REDItools/{{sample_id}}")
    params:
        python=TOOLS["redi_python"],
        script=TOOLS["reditool_known"],
        min_coverage=REDI_CFG["min_coverage"],
        min_base_quality=REDI_CFG["min_base_quality"],
        min_mapq=REDI_CFG["min_mapping_quality"],
        min_variant_reads=REDI_CFG["min_variant_reads"],
        min_editing_frequency=REDI_CFG["min_editing_frequency"]
    threads: THREADS["reditools"]
    resources:
        mem_mb=MEMORY_MB["reditools"]
    log:
        f"{WORK_DIR}/logs/{{sp}}/{{sample_id}}.REDItoolKnown.log"
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.result:q})" "$(dirname {log:q})"
        rm -rf {output.result:q}
        mkdir -p {output.result:q}
        cp {input.sites:q} {output.result:q}/known_sites.redi.tab
        {params.python:q} {params.script:q} \
            -i {input.bam:q} \
            -f {input.fasta:q} \
            -l {output.result:q}/known_sites.redi.tab \
            -t {threads} \
            -o {output.result:q} \
            -c {params.min_coverage} \
            -q {params.min_base_quality} \
            -m {params.min_mapq} \
            -v {params.min_variant_reads} \
            -n {params.min_editing_frequency} \
            > {log:q} 2>&1
        if ! find {output.result:q} -type f -name 'outTable_*' -size +0c -print -quit | grep -q .; then
            echo "ERROR: REDItoolKnown produced no non-empty outTable files." >&2
            exit 1
        fi
        """


# ============================================================
# Merge all samples of each species into one wide count table
# ============================================================

rule merge_all_samples:
    input:
        redi_dirs=lambda wc: [f"{WORK_DIR}/{wc.sp}/04_REDItools/{sample_id}" for sample_id in SAMPLES_BY_SPECIES[wc.sp]],
        metadata=f"{WORK_DIR}/{{sp}}/00_INPUT/site_metadata.tsv",
        samples=SAMPLES_TSV
    output:
        table=f"{WORK_DIR}/{{sp}}/06_ALL_SAMPLES/{{sp}}_all_samples_base_counts.tsv"
    params:
        script=str(Path(workflow.basedir) / "merge_all_sample_base_counts.py"),
        input_dir=lambda wc: f"{WORK_DIR}/{wc.sp}/04_REDItools"
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.table:q})"
        python3 {params.script:q} \
            --sample-table {input.samples:q} \
            --metadata {input.metadata:q} \
            --input-dir {params.input_dir:q} \
            --species {wildcards.sp:q} \
            --output {output.table:q}
        test -s {output.table:q}
        """
