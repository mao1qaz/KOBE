# FASTQ quality control
# ============================================================

rule fastp:
    input:
        fastqs=lambda wc: fastp_input_paths(wc)
    output:
        r1=f"{WORK_DIR}/{{sp}}/00_QC/{{sample_id}}/qc.R1.fastq.gz",
        r2=f"{WORK_DIR}/{{sp}}/00_QC/{{sample_id}}/qc.R2.fastq.gz"
    params:
        html=lambda wc: f"{WORK_DIR}/{wc.sp}/00_QC/{wc.sample_id}/qc.html",
        json=lambda wc: f"{WORK_DIR}/{wc.sp}/00_QC/{wc.sample_id}/qc.json",
        fq1=lambda wc: sample_path(wc, "fq1"),
        fq2=lambda wc: sample_path(wc, "fq2"),
        use_retained_clean=use_retained_clean_fastq,
        fastp=TOOLS["fastp"],
        n=FASTP_CFG["n_base_limit"],
        q=FASTP_CFG["qualified_quality_phred"],
        u=FASTP_CFG["unqualified_percent_limit"],
        extra_args=" ".join(x for x in (
            f"-l {FASTP_CFG['length_required']}" if FASTP_CFG["length_required"] is not None else "",
            "-G" if FASTP_CFG["disable_trim_poly_g"] else ""
        ) if x)
    log:
        f"{WORK_DIR}/logs/{{sp}}/{{sample_id}}.fastp.log"
    threads: THREADS["fastp"]
    resources:
        mem_mb=MEMORY_MB["fastp"]
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.r1:q})" "$(dirname {log:q})"
        if [ {params.use_retained_clean:q} = "true" ]; then
            test -s {output.r1:q}
            test -s {output.r2:q}
            gzip -t {output.r1:q} {output.r2:q}
            echo "Using retained clean FASTQ pair; fastp was not rerun." > {log:q}
        else
            {params.fastp:q} \
                -n {params.n} \
                -q {params.q} \
                -u {params.u} {params.extra_args} \
                --thread {threads} \
                -i {params.fq1:q} \
                -I {params.fq2:q} \
                -o {output.r1:q} \
                -O {output.r2:q} \
                --html {params.html:q} \
                --json {params.json:q} \
                > {log:q} 2>&1
        fi
        """


