# ============================================================
# STAR genome index
# ============================================================

rule star_index:
    input:
        fasta=f"{WORK_DIR}/{{sp}}/00_REF/GENOME/{{sp}}.fa",
        fai=f"{WORK_DIR}/{{sp}}/00_REF/GENOME/{{sp}}.fa.fai",
        gtf=lambda wc: species_path(wc, "gtf")
    output:
        star=directory(f"{WORK_DIR}/{{sp}}/00_REF/STAR")
    params:
        star=TOOLS["star"],
        sjdb_overhang=STAR_CFG["sjdb_overhang"],
        genome_ram=STAR_CFG["limit_genome_generate_ram"],
        sa_index_config=STAR_CFG["genome_sa_index_nbases"]
    threads: THREADS["star_index"]
    resources:
        mem_mb=MEMORY_MB["star_index"]
    shell:
        r"""
        set -euo pipefail
        rm -rf {output.star:q}
        mkdir -p {output.star:q}
        if [ {params.sa_index_config:q} = "auto" ]; then
            SA_INDEX=$(awk '{{sum+=$2}} END {{x=int(log(sum)/log(2)/2-1); if (x<1) x=1; if (x>14) x=14; print x}}' {input.fai:q})
        else
            SA_INDEX={params.sa_index_config}
        fi
        echo "STAR genomeSAindexNbases: $SA_INDEX"
        {params.star:q} --runMode genomeGenerate \
            --runThreadN {threads} \
            --genomeDir {output.star:q} \
            --genomeFastaFiles {input.fasta:q} \
            --sjdbGTFfile {input.gtf:q} \
            --sjdbOverhang {params.sjdb_overhang} \
            --limitGenomeGenerateRAM {params.genome_ram} \
            --genomeSAindexNbases "$SA_INDEX"
        """


