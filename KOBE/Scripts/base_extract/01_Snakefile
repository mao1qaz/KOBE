rule picard_mark_duplicates:
    input:
        bam=f"{WORK_DIR}/{{sp}}/02_Q10/{{sample_id}}/{{sample_id}}.sort.q10.bam",
        bai=f"{WORK_DIR}/{{sp}}/02_Q10/{{sample_id}}/{{sample_id}}.sort.q10.bam.bai"
    output:
        bam=f"{WORK_DIR}/{{sp}}/03_PICARD/{{sample_id}}/{{sample_id}}.sort.q10.nodup.bam",
        bai=f"{WORK_DIR}/{{sp}}/03_PICARD/{{sample_id}}/{{sample_id}}.sort.q10.nodup.bam.bai",
        metrics=f"{WORK_DIR}/{{sp}}/03_PICARD/{{sample_id}}/{{sample_id}}.picard.metrics.txt"
    params:
        java=JAVA,
        picard=TOOLS["picard"],
        heap_g=PICARD_HEAP_G,
        tmp=lambda wc: f"{WORK_DIR}/tmp/Picard/{wc.sp}/{wc.sample_id}",
        picard_index=lambda wc: f"{WORK_DIR}/{wc.sp}/03_PICARD/{wc.sample_id}/{wc.sample_id}.sort.q10.nodup.bai",
        samtools=TOOLS["samtools"],
        create_index=str(PICARD_CFG["create_index"]).lower(),
        remove_duplicates=str(PICARD_CFG["remove_duplicates"]).lower(),
        assume_sorted=str(PICARD_CFG["assume_sorted"]).lower(),
        validation_stringency=PICARD_CFG["validation_stringency"],
        index_threads=THREADS["picard_index"]
    threads: 1
    resources:
        mem_mb=MEMORY_MB["picard"]
    log:
        f"{WORK_DIR}/logs/{{sp}}/{{sample_id}}.Picard.log"
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.bam:q})" "$(dirname {log:q})" {params.tmp:q}
        rm -f {output.bam:q} {output.bai:q} {params.picard_index:q} {output.metrics:q}
        {params.java:q} -Xmx{params.heap_g}g -jar {params.picard:q} MarkDuplicates \
            TMP_DIR={params.tmp:q} \
            INPUT={input.bam:q} \
            OUTPUT={output.bam:q} \
            METRICS_FILE={output.metrics:q} \
            VALIDATION_STRINGENCY={params.validation_stringency} \
            ASSUME_SORTED={params.assume_sorted} \
            CREATE_INDEX={params.create_index} \
            REMOVE_DUPLICATES={params.remove_duplicates} \
            > {log:q} 2>&1
        test -s {output.bam:q}
        test -s {output.metrics:q}
        if [ -s {output.bai:q} ]; then
            :
        elif [ -s {params.picard_index:q} ]; then
            mv {params.picard_index:q} {output.bai:q}
        else
            {params.samtools:q} index -@ {params.index_threads} -o {output.bai:q} {output.bam:q}
        fi
        {params.samtools:q} quickcheck -v {output.bam:q}
        test -s {output.bai:q}
        if ! {params.samtools:q} idxstats {output.bam:q} >/dev/null 2>&1; then
            rm -f {output.bai:q} {params.picard_index:q}
            {params.samtools:q} index -@ {params.index_threads} -o {output.bai:q} {output.bam:q}
        fi
        {params.samtools:q} idxstats {output.bam:q} >/dev/null
        """


