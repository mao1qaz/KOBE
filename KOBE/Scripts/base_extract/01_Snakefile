rule prepare_known_sites:
    input:
        sites=lambda wc: species_path(wc, "sites"),
        fai=f"{WORK_DIR}/{{sp}}/00_REF/GENOME/{{sp}}.fa.fai"
    output:
        redi=f"{WORK_DIR}/{{sp}}/00_INPUT/known_sites.redi.tab",
        metadata=f"{WORK_DIR}/{{sp}}/00_INPUT/site_metadata.tsv"
    params:
        script=str(Path(workflow.basedir) / "prepare_known_sites.py"),
        site_sha256=lambda wc: sha256_file(species_path(wc, "sites"))
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.redi:q})"
        echo "Known-site SHA256: {params.site_sha256}"
        python3 {params.script:q} \
            --input {input.sites:q} \
            --fai {input.fai:q} \
            --redi-output {output.redi:q} \
            --metadata-output {output.metadata:q}
        test -s {output.redi:q}
        test -s {output.metadata:q}
        python3 -c 'import sys; f=open(sys.argv[1], "rb"); magic=f.read(2); f.close(); assert magic != bytes([31, 139]), "Expected uncompressed TSV"' {output.redi:q}
        test ! -e {output.redi:q}.gz
        test ! -e {output.redi:q}.gz.tbi
        """


