#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'USAGE'
Usage:
  find_back --sample_table FILE --out_dir DIR --cds_pos_dir DIR \
    --edit_txt_dir DIR --candi_dir DIR [--gtf species=FILE ...] \
    [--min_samples INT] [--mapping_jobs INT] [--fastp_threads INT] \
    [--bwa_threads INT] [--sort_threads INT] [--sort_mem STRING] \
    [--threads INT] [--min_length INT] [--resume | --force_reditool] \
    [--sif FILE] [--bind DIR ...]

Required:
  --sample_table FILE       Sample manifest with sample_id, individual, species, type, fq1, fq2, and ref.
  --out_dir DIR             Output directory; created on the host.
  --cds_pos_dir DIR         Species-specific CDS position files from ortho_edit.
  --edit_txt_dir DIR        Original known-site references for Known/Novel classification.
  --candi_dir DIR           Candidate-site annotations generated by ortho_edit.

Optional:
  --gtf species=FILE        Repeat for each species requiring genomic-coordinate conversion; omitted species retain CDS-level results.
  --min_samples INT         Minimum supporting samples for site classification (default: 1).
  --mapping_jobs INT        Maximum concurrent sample-level Mapping workflows, including fastp, BWA, sorting, indexing, and Picard (default: 2). When any sample finishes, the next pending sample is started.
  --fastp_threads INT       Threads per fastp process (default: 2).
  --bwa_threads INT         Threads per BWA process (default: 5).
  --sort_threads INT        Threads per Sambamba sort process (default: 5).
  --sort_mem STRING         Memory per Sambamba sort process (default: 12G).
  --threads INT             Total REDItoolKnown CPU-thread budget. Each sample job uses 2 threads; maximum concurrent jobs = threads / 2 (default: 20). Must be an even integer >= 2.
  --min_length INT          Minimum read length passed to fastp -l (default: 150).
  --resume                  Reuse completed Mapping/Picard and REDItoolKnown results when signatures and completeness checks permit.
  --force_reditool          Validate/reuse compatible in-workdir Picard BAMs, then force REDItoolKnown and downstream site recovery.
  --sif FILE                Apptainer image; alternatively set RNA_EDITING_SIF.
  --bind DIR Additional Apptainer bind specification; may be repeated.

The launcher creates --out_dir on the host, discovers paths in the sample
table (fq1, fq2, ref) and each supplied --gtf file, resolves symlink targets,
and binds the relevant filesystem mount points or input directories into the
container at the same absolute paths.
USAGE
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

command -v apptainer >/dev/null 2>&1 || {
  echo "ERROR: apptainer not found" >&2
  exit 1
}
command -v python3 >/dev/null 2>&1 || {
  echo "ERROR: host python3 is required to inspect the sample table and paths" >&2
  exit 1
}

SIF="${RNA_EDITING_SIF:-}"
SAMPLE_TABLE=""
OUT_DIR=""
CDS_POS_DIR=""
EDIT_TXT_DIR=""
CANDI_DIR=""
ARGS=()
USER_BINDS=()
GTF_SPECIES=()
GTF_PATHS=()
PATH_LIST=""
RUN_PID=""
RUN_USE_SETSID=0
LOCK_FILE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --sif)
      [[ $# -ge 2 && -n "$2" ]] || { echo "ERROR: --sif requires a file path." >&2; exit 1; }
      SIF="$2"
      shift 2
      ;;
    --bind|-B)
      [[ $# -ge 2 && -n "$2" ]] || { echo "ERROR: $1 requires a path specification." >&2; exit 1; }
      USER_BINDS+=("$2")
      shift 2
      ;;
    --bind=*)
      USER_BINDS+=("${1#*=}")
      shift
      ;;
    --gtf)
      [[ $# -ge 2 && -n "$2" && "$2" == *=* ]] || {
        echo "ERROR: --gtf requires species=FILE, e.g. --gtf invicta=/path/invicta.gtf" >&2
        exit 1
      }
      GTF_SPECIES+=("${2%%=*}")
      GTF_PATHS+=("${2#*=}")
      ARGS+=(--gtf "$2")
      shift 2
      ;;
    --sample_table|--out_dir|--cds_pos_dir|--edit_txt_dir|--candi_dir)
      [[ $# -ge 2 && -n "$2" ]] || { echo "ERROR: $1 requires a path." >&2; exit 1; }
      key="$1"
      value="$2"
      case "$key" in
        --sample_table) SAMPLE_TABLE="$value" ;;
        --out_dir) OUT_DIR="$value" ;;
        --cds_pos_dir) CDS_POS_DIR="$value" ;;
        --edit_txt_dir) EDIT_TXT_DIR="$value" ;;
        --candi_dir) CANDI_DIR="$value" ;;
      esac
      ARGS+=("$key" "$value")
      shift 2
      ;;
    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done

if [[ -z "$SIF" || ! -s "$SIF" ]]; then
  echo "ERROR: Provide --sif FILE or set RNA_EDITING_SIF to the RNA editing SIF file." >&2
  exit 1
fi
if [[ -z "$SAMPLE_TABLE" || -z "$OUT_DIR" || -z "$CDS_POS_DIR" || -z "$EDIT_TXT_DIR" || -z "$CANDI_DIR" ]]; then
  echo "ERROR: --sample_table, --out_dir, --cds_pos_dir, --edit_txt_dir and --candi_dir are required." >&2
  usage >&2
  exit 1
fi

# Normalize paths lexically on the host. Preserve symlink aliases; their real
# targets are mounted separately below.
abs_path() {
  python3 - "$1" <<'PY'
import os, sys
print(os.path.abspath(os.path.expanduser(sys.argv[1])))
PY
}

SAMPLE_TABLE_ABS="$(abs_path "$SAMPLE_TABLE")"
OUT_DIR_ABS="$(abs_path "$OUT_DIR")"
CDS_POS_DIR_ABS="$(abs_path "$CDS_POS_DIR")"
EDIT_TXT_DIR_ABS="$(abs_path "$EDIT_TXT_DIR")"
CANDI_DIR_ABS="$(abs_path "$CANDI_DIR")"

declare -A GTF_SEEN=()
GTF_PATHS_ABS=()
for i in "${!GTF_SPECIES[@]}"; do
  species="${GTF_SPECIES[$i]}"
  gtf_path="${GTF_PATHS[$i]}"
  [[ "$species" =~ ^[A-Za-z0-9_.-]+$ ]] || { echo "ERROR: Invalid GTF species identifier: $species" >&2; exit 1; }
  [[ -z "${GTF_SEEN[$species]+x}" ]] || { echo "ERROR: GTF supplied more than once for species: $species" >&2; exit 1; }
  GTF_SEEN[$species]=1
  gtf_path="$(abs_path "$gtf_path")"
  [[ -f "$gtf_path" && -s "$gtf_path" ]] || { echo "ERROR: GTF missing, not a regular file, or empty for $species: $gtf_path" >&2; exit 1; }
  GTF_PATHS_ABS+=("$gtf_path")
done

# Validate all user-supplied input paths on the host before starting Apptainer.
[[ -f "$SAMPLE_TABLE_ABS" ]] || { echo "ERROR: Sample table not found: $SAMPLE_TABLE_ABS" >&2; exit 1; }
[[ -d "$CDS_POS_DIR_ABS" ]] || { echo "ERROR: CDS position directory not found: $CDS_POS_DIR_ABS" >&2; exit 1; }
[[ -d "$EDIT_TXT_DIR_ABS" ]] || { echo "ERROR: Original known-site directory not found: $EDIT_TXT_DIR_ABS" >&2; exit 1; }
[[ -d "$CANDI_DIR_ABS" ]] || { echo "ERROR: Candidate annotation directory not found: $CANDI_DIR_ABS" >&2; exit 1; }

# Create output on the HOST before Apptainer starts.
mkdir -p -- "$OUT_DIR_ABS"
# Canonicalize the output directory so symlink aliases resolve to the same
# lock location and cannot launch concurrent runs against the same results.
OUT_DIR_ABS="$(cd -- "$OUT_DIR_ABS" && pwd -P)"

# Acquire a host-side advisory lock for the entire Apptainer run. The lock is
# held by this launcher (and inherited by Apptainer) until the workflow exits.
# The EXIT/signal trap removes the lock-file pathname for normal exits and
# catchable signals. SIGKILL cannot be trapped; the kernel still releases flock
# when the last process holding this descriptor exits.
command -v flock >/dev/null 2>&1 || {
  echo "ERROR: flock is required on the host to protect the output directory." >&2
  exit 1
}
LOCK_FILE="$OUT_DIR_ABS/.find_back.lock"
exec 9<>"$LOCK_FILE"
if ! flock -n 9; then
  echo "ERROR: Another find_back run is already using this output directory." >&2
  echo "Output directory: $OUT_DIR_ABS" >&2
  echo "Lock file: $LOCK_FILE" >&2
  if [[ -s "$LOCK_FILE" ]]; then
    echo "Existing lock information:" >&2
    cat "$LOCK_FILE" >&2 || true
  fi
  echo "Wait for that run to finish before starting another run here." >&2
  exit 1
fi
: > "$LOCK_FILE"
printf 'pid=%s\nhost=%s\nstarted=%s\noutput_dir=%s\n' \
  "$$" "$(hostname)" "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$OUT_DIR_ABS" >&9

cleanup_launcher() {
  local status=$?
  trap - EXIT INT TERM HUP
  if [[ -n "${RUN_PID:-}" ]] && kill -0 "$RUN_PID" 2>/dev/null; then
    if (( RUN_USE_SETSID == 1 )); then
      kill -TERM -- "-$RUN_PID" 2>/dev/null || true
    else
      kill -TERM "$RUN_PID" 2>/dev/null || true
    fi
    wait "$RUN_PID" 2>/dev/null || true
  fi
  [[ -n "${PATH_LIST:-}" ]] && rm -f "$PATH_LIST"
  [[ -n "${LOCK_FILE:-}" ]] && rm -f "$LOCK_FILE"
  exit "$status"
}
trap cleanup_launcher EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

# Replace path arguments with absolute paths so host and container refer to
# precisely the same locations, independent of the caller's working directory.
ARGS_ABS=()
for ((i=0; i<${#ARGS[@]}; i++)); do
  case "${ARGS[$i]}" in
    --sample_table) ARGS_ABS+=(--sample_table "$SAMPLE_TABLE_ABS"); ((i+=1)) ;;
    --out_dir) ARGS_ABS+=(--out_dir "$OUT_DIR_ABS"); ((i+=1)) ;;
    --cds_pos_dir) ARGS_ABS+=(--cds_pos_dir "$CDS_POS_DIR_ABS"); ((i+=1)) ;;
    --gtf)
      gtf_value="${ARGS[$((i+1))]}"
      gtf_species="${gtf_value%%=*}"
      gtf_path="$(abs_path "${gtf_value#*=}")"
      ARGS_ABS+=(--gtf "$gtf_species=$gtf_path")
      ((i+=1))
      ;;
    --edit_txt_dir) ARGS_ABS+=(--edit_txt_dir "$EDIT_TXT_DIR_ABS"); ((i+=1)) ;;
    --candi_dir) ARGS_ABS+=(--candi_dir "$CANDI_DIR_ABS"); ((i+=1)) ;;
    *) ARGS_ABS+=("${ARGS[$i]}") ;;
  esac
done
ARGS=("${ARGS_ABS[@]}")

# Bind the filesystem mount containing each input path. For symlinks, bind both
# the supplied path's filesystem and the resolved target's filesystem. This
# avoids assumptions about cluster-specific storage mount names.
BIND_ARGS=()
BIND_SEEN="|"
add_root_bind_for_path() {
  local path="$1" lexical resolved candidate source
  [[ -n "$path" ]] || return 0
  lexical="$(abs_path "$path")"
  resolved="$(readlink -f -- "$lexical" 2>/dev/null || true)"
  for candidate in "$lexical" "$resolved"; do
    [[ -n "$candidate" && "$candidate" == /* ]] || continue
    source=""
    if [[ "$candidate" == "$lexical" && -n "$resolved" && "$resolved" != "$lexical" ]]; then
      if [[ -d "$lexical" && ! -L "$lexical" ]]; then source="$lexical"; else source="$(dirname "$lexical")"; fi
    else
      if command -v findmnt >/dev/null 2>&1 && [[ -e "$candidate" ]]; then
        source="$(findmnt -T "$candidate" -n -o TARGET 2>/dev/null | head -n 1 || true)"
      fi
      if [[ -z "$source" || "$source" == "/" ]]; then
        if [[ -d "$candidate" ]]; then source="$candidate"; else source="$(dirname "$candidate")"; fi
      fi
    fi
    [[ "$source" != "/" && -d "$source" ]] || continue
    if [[ "$BIND_SEEN" != *"|$source|"* ]]; then
      BIND_ARGS+=(--bind "$source:$source")
      BIND_SEEN+="$source|"
    fi
  done
}

# The module itself and all explicitly named path arguments.
add_root_bind_for_path "$SCRIPT_DIR"
add_root_bind_for_path "$SAMPLE_TABLE_ABS"
add_root_bind_for_path "$OUT_DIR_ABS"
add_root_bind_for_path "$CDS_POS_DIR_ABS"
for gtf_path in "${GTF_PATHS_ABS[@]}"; do add_root_bind_for_path "$gtf_path"; done
add_root_bind_for_path "$EDIT_TXT_DIR_ABS"
add_root_bind_for_path "$CANDI_DIR_ABS"

# Read fq1/fq2/ref from the sample table exactly as main.sh does: relative
# paths are relative to the sample table's parent directory.
PATH_LIST="$(mktemp)"
python3 - "$SAMPLE_TABLE_ABS" > "$PATH_LIST" <<'PY'
import csv
import os
import sys
from pathlib import Path

sample_table = Path(sys.argv[1])
with sample_table.open("r", encoding="utf-8-sig", newline="") as handle:
    reader = csv.DictReader(handle, delimiter="\t")
    if not reader.fieldnames:
        raise SystemExit("ERROR: sample table has no header")
    reader.fieldnames = [x.strip().lstrip("\ufeff") for x in reader.fieldnames]
    missing = [x for x in ("fq1", "fq2", "ref") if x not in reader.fieldnames]
    if missing:
        raise SystemExit("ERROR: sample table missing columns: " + ", ".join(missing))
    for row in reader:
        for key in ("fq1", "fq2", "ref"):
            value = (row.get(key) or "").strip()
            if not value:
                continue
            path = Path(value).expanduser()
            if not path.is_absolute():
                path = sample_table.parent / path
            sys.stdout.buffer.write(os.path.abspath(str(path)).encode() + b"\0")
PY

while IFS= read -r -d '' input_path; do
  add_root_bind_for_path "$input_path"
done < "$PATH_LIST"

# Also resolve symlinks placed inside the CDS-position, known-site, and candidate directories.
for input_dir in "$CDS_POS_DIR_ABS" "$EDIT_TXT_DIR_ABS" "$CANDI_DIR_ABS"; do
  if [[ -d "$input_dir" ]]; then
    while IFS= read -r -d '' entry; do
      add_root_bind_for_path "$entry"
    done < <(find -L "$input_dir" -maxdepth 1 -type f -print0 2>/dev/null || true)
  fi
done

# Add user-requested binds. The full specification is passed unchanged to
# Apptainer; source roots are also mounted so symlinked bind sources resolve.
for spec in "${USER_BINDS[@]}"; do
  [[ -n "$spec" ]] || continue
  source_path="${spec%%:*}"
  add_root_bind_for_path "$source_path"
  BIND_ARGS+=(--bind "$spec")
done

# Avoid duplicate bind entries in the argument list where possible; Apptainer
# accepts repeated binds, and user-specified mappings are intentionally retained.
echo "[find_back launcher] SIF: $SIF"
echo "[find_back launcher] Host output directory: $OUT_DIR_ABS"
echo "[find_back launcher] Additional bind specifications: ${#USER_BINDS[@]}"
echo "[find_back launcher] Automatic bind roots: $(( ${#BIND_ARGS[@]} / 2 - ${#USER_BINDS[@]} ))"

echo "[find_back launcher] Lock acquired: $LOCK_FILE"
echo "[find_back launcher] Lock owner PID: $$"

# Keep this shell alive while Apptainer runs so FD 9 continues holding flock.
if command -v setsid >/dev/null 2>&1; then
  RUN_USE_SETSID=1
  setsid apptainer exec "${BIND_ARGS[@]}" "$SIF" bash "$SCRIPT_DIR/main.sh" "${ARGS[@]}" &
else
  apptainer exec "${BIND_ARGS[@]}" "$SIF" bash "$SCRIPT_DIR/main.sh" "${ARGS[@]}" &
fi
RUN_PID=$!
set +e
wait "$RUN_PID"
RUN_STATUS=$?
set -e
RUN_PID=""
exit "$RUN_STATUS"
